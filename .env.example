NEXT_PUBLIC_API_URL=http://localhost:7100
# Base URL for profile images (Spaces CDN or backend /uploads)
NEXT_PUBLIC_SPACES_URL=https://nexustorage.sgp1.digitaloceanspaces.com
# Site URL for SEO (meta tags, sitemap, Open Graph) - use your production domain
NEXT_PUBLIC_SITE_URL=https://thoughtexpense.com

# Sentry. Leave the DSN empty to disable error reporting entirely.
# NEXT_PUBLIC_* is inlined at build time, so this must be set when `next build`
# runs — setting it only in the runtime environment does nothing.
# The DSN is public by design; it ships in the client bundle.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to send server/edge errors to a different project than the browser.
SENTRY_DSN=

# Build-time only, for uploading source maps so stack traces are readable.
# Without the token the build still succeeds, but Sentry shows minified frames.
# SENTRY_AUTH_TOKEN is a real credential — never prefix it with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
